# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Your bot's username (without @)
BOT_USERNAME=your_bot_username

# The URL where this server is deployed (used for Mini App)
# Example: https://yourdomain.com
APP_URL=https://yourdomain.com

# Port for the Express server
PORT=3000

# Loadboard URL to monitor
LOADBOARD_URL=https://tezway.net

# How often to check for new loads (in seconds, default 60)
CHECK_INTERVAL_SECONDS=60

# FedEx / Zuumapp credentials (leave empty to disable FedEx monitoring)
FEDEX_USERNAME=your_fedex_email@example.com
FEDEX_PASSWORD=your_fedex_password
